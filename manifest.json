{
  "manifest_version": 3,
  "name": "LOCKED",
  "description": "Secure local password vault and breach checker.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "locked-vault@yourdomain.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "logo.png"
  },
  "icons": {
    "128": "logo.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.pwnedpasswords.com/*"
  ]
}